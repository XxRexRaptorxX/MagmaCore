#!/bin/sh
# Auto-generated post-commit hook for RC tagging and pushing
# This hook will be executed after every commit

echo "🏷️  Creating RC tag for new commit..."

# Get the project directory
PROJECT_DIR="F:\Modding\MagmaCore"

# Change to project directory
cd "$PROJECT_DIR"

# Get current version
CURRENT_VERSION="1.3.3"

# Check if this is a version change by comparing with the last RC tag
LAST_RC_TAG=$(git tag -l "v.*-RC*" --sort=-version:refname | head -n1)
if [ -n "$LAST_RC_TAG" ]; then
    LAST_VERSION=$(echo "$LAST_RC_TAG" | sed 's/v\.\([0-9]\+\.[0-9]\+\.[0-9]\+\)-RC[0-9]\+/\1/')
    echo "📋 Last version from tags: $LAST_VERSION"
    echo "📋 Current version: $CURRENT_VERSION"
    
    if [ "$LAST_VERSION" != "$CURRENT_VERSION" ]; then
        echo "🎉 Version change detected: $LAST_VERSION -> $CURRENT_VERSION"
        echo "🚀 Creating GitHub release for version $LAST_VERSION..."
        
        # Run Gradle task to create GitHub release for the old version
        cd "$PROJECT_DIR"
        ./gradlew createGitHubRelease -PreleaseVersion="$LAST_VERSION" -q
    fi
fi

# Get next RC number by checking existing RC tags for current version
RC_TAGS=$(git tag -l "v.$CURRENT_VERSION-RC*" | wc -l)
NEXT_RC=$((RC_TAGS + 1))
RC_TAG="v.$CURRENT_VERSION-RC$NEXT_RC"

echo "🔖 Creating tag: $RC_TAG"

# Create the RC tag on the latest commit
git tag -a "$RC_TAG" -m "Auto-generated RC tag $NEXT_RC for version $CURRENT_VERSION"

# Push the tag to remote
echo "⬆️  Pushing tag to remote..."
git push origin "$RC_TAG"

if [ $? -eq 0 ]; then
    echo "✅ Successfully created and pushed RC tag: $RC_TAG"
else
    echo "❌ Failed to push RC tag: $RC_TAG"
fi

# Also update the changelog
echo "📝 Updating changelog..."
cd "$PROJECT_DIR"
./gradlew updateChangelog -q

echo "🎉 RC tagging complete!"
