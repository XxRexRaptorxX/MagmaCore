#!/bin/sh
# Auto-generated post-commit hook for RC tagging and pushing
# This hook will be executed after every commit

echo "🏷️  Creating Dev tag for new commit..."

# Get project root (one level up from .githooks folder)
PROJECT_DIR="$(dirname "$(dirname "$0")")"
cd "$PROJECT_DIR" || exit 1

# Read version from gradle.properties
CURRENT_VERSION=$(grep "^mod_version=" gradle.properties | cut -d'=' -f2)

if [ -z "$CURRENT_VERSION" ]; then
    echo "❌ Could not read version from gradle.properties"
    exit 1
fi

# Check if this is a version change by comparing with the last Dev tag
LAST_DEV_TAG=$(git tag -l "v.*-dev*" --sort=-version:refname | head -n1)
if [ -n "$LAST_DEV_TAG" ]; then
    LAST_VERSION=$(echo "$LAST_DEV_TAG" | sed 's/v\.\([0-9]\+\.[0-9]\+\.[0-9]\+\)-dev[0-9]\+/\1/')
    echo "📋 Last version from tags: $LAST_VERSION"
    echo "📋 Current version: $CURRENT_VERSION"

    if [ "$LAST_VERSION" != "$CURRENT_VERSION" ]; then
        echo "🎉 Version change detected: $LAST_VERSION -> $CURRENT_VERSION"
        echo "🚀 Creating GitHub release for version $LAST_VERSION..."

        ./gradlew createGitHubRelease -PreleaseVersion="$LAST_VERSION" -q
    fi
fi

# Get next dev number by checking existing dev tags for current version
DEV_TAGS=$(git tag -l "v.$CURRENT_VERSION-dev*" | wc -l)
NEXT_DEV=$((DEV_TAGS + 1))
DEV_TAG="v.$CURRENT_VERSION-dev$NEXT_DEV"

echo "🔖 Creating tag: $DEV_TAG"

# Create the DEV tag on the latest commit
git tag -a "$DEV_TAG" -m "Auto-generated dev tag $NEXT_DEV for version $CURRENT_VERSION"

# Push the tag to remote
echo "⬆️  Pushing tag to remote..."
git push origin "$DEV_TAG"

if [ $? -eq 0 ]; then
    echo "✅ Successfully created and pushed dev tag: $DEV_TAG"
else
    echo "❌ Failed to push dev tag: $DEV_TAG"
fi

# Also update the changelog
echo "📝 Updating changelog..."
./gradlew updateChangelog -q

if ! git diff --quiet -- LATEST_CHANGELOG.md; then
  git add LATEST_CHANGELOG.md
  git commit -m "chore: update LATEST_CHANGELOG.md [skip ci]"
else
  echo "ℹ️ No changes in LATEST_CHANGELOG.md"
fi